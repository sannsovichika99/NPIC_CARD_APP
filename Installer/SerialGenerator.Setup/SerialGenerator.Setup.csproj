<?xml version="1.0" encoding="utf-8"?>
<!--
  SerialGenerator-Setup.exe: single-file installer for the Card Studio Serial Generator (Tools\SerialGenerator).

  Same setup engine as CardStudio-Setup.exe: every .cs file of Installer\CardStudio.Setup is compiled here too, except
  ProductInfo.cs, which this folder replaces with the generator's name, paths and texts. Fix the engine once, both setups get it.

  For the administrator's PC only. It does NOT contain the private key (serial-private.key) or the serial log:
  the payload refuses them (see BuildPayload).
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Release</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{8D41F2A6-3C5B-4E97-A1D8-0B6E2F7C9A14}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CardStudio.Setup</RootNamespace>
    <AssemblyName>SerialGenerator-Setup</AssemblyName>
    <!-- 4.8 like CardStudio-Setup: starts on Windows 10 and explains that .NET Framework 4.8.1 is needed. -->
    <TargetFrameworkVersion>v4.8</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <Deterministic>true</Deterministic>
    <PlatformTarget>AnyCPU</PlatformTarget>
    <Prefer32Bit>false</Prefer32Bit>
    <ApplicationIcon>..\..\NPIC_CARD_APP\Assets\app.ico</ApplicationIcon>
    <ApplicationManifest>..\CardStudio.Setup\app.manifest</ApplicationManifest>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <DebugType>none</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>

  <!-- The program this setup packages. -->
  <PropertyGroup>
    <AppOutputDir>$(MSBuildThisFileDirectory)..\..\Tools\SerialGenerator\bin\$(Configuration)\</AppOutputDir>
    <AppExeName>CardStudio.SerialGenerator.exe</AppExeName>
    <!-- dist\admin\, not dist\: dist\ is what gets published as a Card Studio release; this tool is not for users. -->
    <DistDir>$(MSBuildThisFileDirectory)..\..\dist\admin\</DistDir>
    <EngineDir>..\CardStudio.Setup\</EngineDir>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.IO.Compression" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <Compile Include="ProductInfo.cs" />
    <Compile Include="..\..\Tools\SerialGenerator\GeneratorVersion.cs">
      <Link>GeneratorVersion.cs</Link>
    </Compile>
    <!-- The shared setup engine (all of CardStudio.Setup except its ProductInfo.cs). -->
    <Compile Include="$(EngineDir)*.cs" Exclude="$(EngineDir)ProductInfo.cs">
      <Link>Engine\%(Filename)%(Extension)</Link>
    </Compile>
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="..\..\NPIC_CARD_APP\Assets\app_logo.png">
      <LogicalName>CardStudio.Setup.logo.png</LogicalName>
    </EmbeddedResource>
  </ItemGroup>

  <!-- Builds the generator first (same Configuration) without referencing its assembly. -->
  <ItemGroup>
    <ProjectReference Include="..\..\Tools\SerialGenerator\SerialGenerator.csproj">
      <Project>{5E2B7C4D-9A13-4F68-B0D2-6C8E1A3F9B57}</Project>
      <Name>SerialGenerator</Name>
      <ReferenceOutputAssembly>false</ReferenceOutputAssembly>
      <Private>false</Private>
    </ProjectReference>
  </ItemGroup>

  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />

  <!--
    Payload: the generator's build output, zipped and embedded. A private key, serial log or remembered key path that
    was dropped into the output folder (e.g. to test "key next to the exe") is LEFT OUT, with a warning, so the setup
    can never hand out the key.
  -->
  <Target Name="BuildPayload" AfterTargets="ResolveProjectReferences">
    <PropertyGroup>
      <PayloadStageDir>$(MSBuildThisFileDirectory)$(IntermediateOutputPath)payload\</PayloadStageDir>
      <PayloadZip>$(MSBuildThisFileDirectory)$(IntermediateOutputPath)payload.zip</PayloadZip>
    </PropertyGroup>
    <Error Condition="!Exists('$(AppOutputDir)$(AppExeName)')"
           Text="Serial Generator build output not found: $(AppOutputDir)$(AppExeName)" />
    <ItemGroup>
      <SecretFile Include="$(AppOutputDir)**\*.key;$(AppOutputDir)**\serials*.csv;$(AppOutputDir)**\key-path.txt" />
      <PayloadFile Include="$(AppOutputDir)**\*"
                   Exclude="$(AppOutputDir)**\*.pdb;$(AppOutputDir)**\*.vshost.*;@(SecretFile)" />
    </ItemGroup>
    <Warning Condition="'@(SecretFile)' != ''"
             Text="Left out of the setup (never ship the key or the serial log): @(SecretFile)" />
    <RemoveDir Directories="$(PayloadStageDir)" />
    <Copy SourceFiles="@(PayloadFile)"
          DestinationFiles="@(PayloadFile->'$(PayloadStageDir)%(RecursiveDir)%(Filename)%(Extension)')" />
    <ZipDirectory SourceDirectory="$(PayloadStageDir)" DestinationFile="$(PayloadZip)" Overwrite="true" />
    <ItemGroup>
      <EmbeddedResource Include="$(PayloadZip)">
        <LogicalName>CardStudio.Setup.payload.zip</LogicalName>
      </EmbeddedResource>
    </ItemGroup>
    <Message Importance="high" Text="Payload: @(PayloadFile->Count()) files -> $(PayloadZip)" />
  </Target>

  <!-- Release builds also drop the single-file setup into <repo>\dist\admin\. -->
  <Target Name="CopyToDist" AfterTargets="Build" Condition=" '$(Configuration)' == 'Release' ">
    <Copy SourceFiles="$(TargetPath)" DestinationFolder="$(DistDir)" />
    <Message Importance="high" Text="Setup: $(DistDir)$(TargetFileName)" />
  </Target>
</Project>
