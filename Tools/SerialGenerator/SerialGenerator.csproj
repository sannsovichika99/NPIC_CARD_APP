<?xml version="1.0" encoding="utf-8"?>
<!--
  Card Studio Serial Generator: the administrator's tool that turns a PC's Machine ID into its serial number.
  NOT part of the setup (the installer only packs NPIC_CARD_APP\bin\<Configuration>). Never give it to users:
  whoever has it AND serial-private.key can make serials.
-->
<Project ToolsVersion="15.0" xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <Import Project="$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props" Condition="Exists('$(MSBuildExtensionsPath)\$(MSBuildToolsVersion)\Microsoft.Common.props')" />
  <PropertyGroup>
    <Configuration Condition=" '$(Configuration)' == '' ">Debug</Configuration>
    <Platform Condition=" '$(Platform)' == '' ">AnyCPU</Platform>
    <ProjectGuid>{5E2B7C4D-9A13-4F68-B0D2-6C8E1A3F9B57}</ProjectGuid>
    <OutputType>WinExe</OutputType>
    <RootNamespace>CardStudio.SerialGenerator</RootNamespace>
    <AssemblyName>CardStudio.SerialGenerator</AssemblyName>
    <TargetFrameworkVersion>v4.8.1</TargetFrameworkVersion>
    <LangVersion>7.3</LangVersion>
    <FileAlignment>512</FileAlignment>
    <AutoGenerateBindingRedirects>true</AutoGenerateBindingRedirects>
    <Deterministic>true</Deterministic>
    <ApplicationIcon>..\..\NPIC_CARD_APP\Assets\app.ico</ApplicationIcon>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Debug|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugSymbols>true</DebugSymbols>
    <DebugType>full</DebugType>
    <Optimize>false</Optimize>
    <OutputPath>bin\Debug\</OutputPath>
    <DefineConstants>DEBUG;TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <PropertyGroup Condition=" '$(Configuration)|$(Platform)' == 'Release|AnyCPU' ">
    <PlatformTarget>AnyCPU</PlatformTarget>
    <DebugType>pdbonly</DebugType>
    <Optimize>true</Optimize>
    <OutputPath>bin\Release\</OutputPath>
    <DefineConstants>TRACE</DefineConstants>
    <ErrorReport>prompt</ErrorReport>
    <WarningLevel>4</WarningLevel>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="System" />
    <Reference Include="System.Core" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Windows.Forms" />
  </ItemGroup>
  <ItemGroup>
    <!-- Same serial format and public key as the app, so a serial that passes here passes in Card Studio. -->
    <Compile Include="..\..\NPIC_CARD_APP\Services\SerialFormat.cs">
      <Link>Shared\SerialFormat.cs</Link>
    </Compile>
    <Compile Include="..\..\NPIC_CARD_APP\Services\LicenseService.cs">
      <Link>Shared\LicenseService.cs</Link>
    </Compile>
    <Compile Include="Program.cs" />
    <Compile Include="SigningKey.cs" />
    <Compile Include="SerialLog.cs" />
    <Compile Include="GeneratorForm.cs">
      <SubType>Form</SubType>
    </Compile>
  </ItemGroup>
  <Import Project="$(MSBuildToolsPath)\Microsoft.CSharp.targets" />
</Project>
